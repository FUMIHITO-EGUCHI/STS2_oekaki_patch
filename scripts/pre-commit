#!/bin/sh
# pre-commit hook
# install with: sh scripts/setup-hooks.sh

BRANCH="$(git branch --show-current)"
BRANCH_PATTERN='^(feature|fix|refactor|docs|chore)/[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$'
SKIP_PATTERN='^chore/skip-[a-z0-9]+(-[a-z0-9]+)*$'

case "$BRANCH" in
  master|main)
    if [ "$ALLOW_MASTER_COMMIT" != "1" ]; then
      echo ""
      echo "Error: direct commit to $BRANCH is not allowed."
      echo "  Start work with: sh scripts/start-issue.sh <type> <number> <topic>"
      echo "  For maintenance commits, set ALLOW_MASTER_COMMIT=1"
      exit 1
    fi
    ;;
  *)
    if ! printf "%s\n" "$BRANCH" | grep -Eq "$BRANCH_PATTERN|$SKIP_PATTERN"; then
      echo ""
      echo "Branch name does not follow naming convention."
      echo "  Use: sh scripts/start-issue.sh <type> <number> <topic>"
      echo "  Allowed: feature|fix|refactor|docs|chore/<number>-<topic>, chore/skip-<topic>"
      exit 1
    fi
    ;;
esac

dotnet build src/EraserMod -c Release
if [ $? -ne 0 ]; then
  echo ""
  echo "Pre-commit check failed: EraserMod build failed."
  exit 1
fi

dotnet build src/Injector -c Release
if [ $? -ne 0 ]; then
  echo ""
  echo "Pre-commit check failed: Injector build failed."
  exit 1
fi

# gitleaks: staged diff の秘密スキャン（未インストール時は警告のみ）
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact
  if [ $? -ne 0 ]; then
    echo ""
    echo "Pre-commit check failed: gitleaks detected potential secrets in staged files."
    exit 1
  fi
else
  echo "[pre-commit] gitleaks not installed — skipping secret scan."
  echo "[pre-commit]   Install: https://github.com/gitleaks/gitleaks#installing"
fi
